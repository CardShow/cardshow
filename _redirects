# Marketplace read-only MCP server (Phase 1) — AI assistants connect to https://getcardshow.com/mcp
/mcp    /.netlify/functions/mcp    200

# Marketplace buyer site (Astro, its own Netlify site built from buyer/, named cardshow-buyer).
# getcardshow.com serves it at these paths so printed QR codes and the dealer app keep their URLs.
# If the buyer site gets a different Netlify name, change the host on these lines.
/search      https://cardshow-buyer.netlify.app/search      200
/account     https://cardshow-buyer.netlify.app/account     200
/c/*         https://cardshow-buyer.netlify.app/c/:splat    200
/d/*         https://cardshow-buyer.netlify.app/d/:splat    200
/_astro/*    https://cardshow-buyer.netlify.app/_astro/:splat  200
# robots.txt and sitemap.xml for the whole domain are made by the buyer site (noindex/closed until
# BUYER_SITE_INDEXING=true there). Cloudflare adds its own content-signals comment block on top.
/robots.txt  https://cardshow-buyer.netlify.app/robots.txt  200
/sitemap.xml https://cardshow-buyer.netlify.app/sitemap.xml 200
# The buyer site's source is in this repo (published here as plain files); don't serve it.
/buyer/*     /buyer-source-not-served  404!

# Platform app
/app    /app.html    200

# Public show pages — must stay at .html to preserve hash fragment
/show     /show.html    200
/show/    /show.html    200
/show/*   /show.html    200

# Privacy policy
/privacy     /privacy.html    200
/privacy/    /privacy.html    200

# Seller browse
/seller-browse     /seller-browse.html    200
/seller-browse/    /seller-browse.html    200

# Trade Zone
/trade-zone     /trade-zone.html    200
/trade-zone/    /trade-zone.html    200
/trade-board    /trade-board.html   200
/trade-board/   /trade-board.html   200

# Public trade link — social crawlers get server-rendered OG tags,
# human visitors get redirected into the SPA (see trade-og.js)
/trade/:id      /.netlify/functions/trade-og?id=:id    200
