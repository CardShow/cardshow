---
// /c/<id>-<slug> — one listing. Server-rendered with schema.org Product/Offer data for search engines and
// AI assistants. Active, on-hold and sold cards open (a shared link keeps working); anything else is a 404.
// Until checkout exists (Phase 2), buyers contact the dealer or find them at their show table.
import Base from '../../layouts/Base.astro';
import { rpc } from '../../lib/api.js';
import { env } from '../../lib/env.js';
import { money, gradeLabel, pctLabel, imageFor, dateRange, place, timeAgo } from '../../lib/format.js';

const raw = String(Astro.params.slug || '');
const id = raw.slice(0, 36);
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
let l: any = null, failed = false;
if (UUID.test(id)) {
  try { l = await rpc('get_listing', { p_id: id }); } catch (e: any) { failed = true; console.error('[listing]', e?.message); }
}
if (failed) { Astro.locals.cache = 0; Astro.response.status = 503; }
const found = l && !l.error;
if (!found && !failed) {
  Astro.response.status = 404;
  Astro.locals.cache = 30;
}
// Old or mistyped slug → the canonical URL.
if (found && l.url && `/c/${raw}` !== l.url) return Astro.redirect(l.url + Astro.url.search, 301);

const site = env.siteUrl();
const img = found ? imageFor(l, { supabaseUrl: env.supabaseUrl(), siteUrl: site }) : null;
const grade = found ? gradeLabel(l) : '';
const status = found ? l.listing_status : '';
const pct = found && l.comp ? pctLabel(l.pct_of_comp) : '';
const show = found ? l.show : null;
const dealer = found ? l.dealer : null;
const modes: string[] = found && Array.isArray(l.sale_modes) ? l.sale_modes : ['ship'];
const ships = modes.includes('ship');
const pickup = modes.includes('local_pickup');
const shipText = !found || !ships ? '' : l.shipping_cents === 0 ? 'Free shipping' : l.shipping_cents > 0 ? `Ships for ${money(l.shipping_cents, { cents: true })}` : 'Ships · ask the dealer about shipping';
const showUrl = show ? (show.url || `/show.html?id=${encodeURIComponent(show.id)}`) : '';
const details = found ? [
  ['Player / character', l.player], ['Year', l.year], ['Set', l.set], ['Card #', l.number],
  ['Parallel', l.parallel], ['Grade', grade !== 'Raw' ? grade : 'Raw (ungraded)'], ['Cert #', l.cert_number],
  ['Serial #', l.serial_number && l.print_run_size ? `${l.serial_number}/${l.print_run_size}` : l.serial_number],
  ['Features', Array.isArray(l.features) && l.features.length ? l.features.join(', ') : null],
  ['Category', [l.category, l.subcategory].filter(Boolean).join(' · ')],
].filter(([, v]) => v !== null && v !== undefined && v !== '') : [];
const msgText = found ? `Hi! I saw your ${l.title} on CardShow for ${money(l.price_cents)}. Is it still available?` : '';
const waUrl = dealer?.whatsapp ? `https://wa.me/${dealer.whatsapp}?text=${encodeURIComponent(msgText)}` : null;
const igUrl = dealer?.instagram ? `https://instagram.com/${encodeURIComponent(dealer.instagram)}` : null;
const description = found
  ? `${l.title} · ${grade} · ${money(l.price_cents)}${l.comp ? ` (market ${money(l.comp.value_cents)})` : ''}${show ? ` · at ${show.name}${place(show) ? ', ' + place(show) : ''}` : ''}.`
  : 'This card isn’t listed any more.';
const jsonLd = found ? {
  '@context': 'https://schema.org', '@type': 'Product',
  name: l.title, sku: l.id, url: site + l.url,
  ...(img ? { image: img.url } : {}),
  ...(l.category ? { category: [l.category, l.subcategory].filter(Boolean).join(' > ') } : {}),
  description,
  offers: {
    '@type': 'Offer', url: site + l.url, priceCurrency: 'USD', price: (l.price_cents / 100).toFixed(2),
    availability: status === 'active' ? 'https://schema.org/InStock' : status === 'sold' ? 'https://schema.org/SoldOut' : 'https://schema.org/LimitedAvailability',
    seller: { '@type': 'Organization', name: dealer?.display_name || dealer?.handle },
  },
} : null;
---
<Base title={found ? `${l.title} · ${grade}` : failed ? 'Listing unavailable' : 'Card not found'} description={description}
      canonical={found ? l.url : undefined} image={img?.url} noindex={!found}>
  {jsonLd && <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}

  {!found && (
    <div class="gone">
      <h1>{failed ? 'Couldn’t load this card' : 'This card isn’t listed any more'}</h1>
      <p class="muted">{failed ? 'Try again in a minute.' : 'The dealer sold it or took it off CardShow.'}</p>
      <a class="btn btn-primary" href="/search">Search other cards</a>
    </div>
  )}

  {found && (
    <article class="listing" data-id={l.id} data-status={status}>
      <div class={img?.kind === 'catalog' ? 'media is-catalog' : 'media'}>
        {img?.kind === 'catalog'
          ? <div class="frame"><img src={img.url} alt={l.title} /></div>
          : img ? <img src={img.url} alt={l.title} width="500" height="700" /> : <div class="ph">No photo yet</div>}
        {img?.kind === 'catalog' && <p class="muted small">Catalog image. The dealer’s card may differ (centering, corners).</p>}
      </div>

      <div class="info">
        <div class="chips">
          <span class="chip chip-grade">{grade}</span>
          {l.deal && <span class="chip chip-deal">Deal</span>}
          {status === 'reserved' && <span class="chip chip-hold">On hold for a buyer</span>}
          {status === 'sold' && <span class="chip chip-sold">Sold</span>}
        </div>
        <h1>{l.title}</h1>
        <div class="price">{money(l.price_cents)}</div>
        {l.accepts_offers && status === 'active' && <p class="muted small">The dealer takes offers.</p>}
        {status !== 'sold' && (ships || pickup) && (
          <ul class="delivery" aria-label="Delivery">
            {ships && <li>📦 {shipText}</li>}
            {pickup && <li>🤝 {show?.pickup ? `Pick up at ${show.name}` : show ? `Pick up at a show (next: ${show.name})` : 'Pick up in person'}</li>}
          </ul>
        )}

        {l.comp ? (
          <section class="box comp" aria-label="Market value">
            <div class="row"><span>Market value</span><b>{money(l.comp.value_cents)}</b></div>
            {pct && <div class={`pct ${pct.includes('under') ? 'under' : pct.includes('over') ? 'over' : ''}`}>This price is {pct.toLowerCase()}</div>}
            {(l.comp.low_cents || l.comp.high_cents) && <div class="row muted"><span>Recent range</span><span>{money(l.comp.low_cents)}–{money(l.comp.high_cents)}</span></div>}
            {l.comp.sales_30d != null && <div class="row muted"><span>Sales in the last 30 days</span><span>{l.comp.sales_30d}</span></div>}
            {l.comp.few_sales && <p class="muted small">Few recent sales, so this value is less certain.</p>}
            <p class="muted small">Based on recent sales of this card in this grade{l.comp.refreshed_at ? `, updated ${timeAgo(l.comp.refreshed_at)}` : ''}.</p>
          </section>
        ) : (
          <p class="muted small">No market value for this card yet.</p>
        )}

        {l.gtcr_clear && (
          <section class="box gtcr">
            <b>✓ No stolen or lost report</b>
            <p class="muted small">{l.grader} cert {l.cert_number} was checked with the Global Trading Card Registry this week.</p>
          </section>
        )}

        {status !== 'sold' && (
          <section class="box buy" aria-label="How to buy">
            <h2>How to buy</h2>
            <div class="hold" id="holdBox" data-id={l.id} data-status={status} data-url={l.url}>
              {status === 'reserved' && <p class="hold-other" id="holdOther">Another buyer is holding this card. If they don’t buy it, it goes back on sale within a day.</p>}
              <div id="holdMine" class="hold-mine" hidden>
                <b>✓ On hold for you</b>
                <span id="holdPrice" hidden></span>
                <span id="holdUntil"></span>
                <span class="muted small">Pay the dealer when you meet{show ? `, at ${show.name}${show.table_number ? ` (table ${show.table_number})` : ''}` : ''}. They have your contact details.</span>
                <button class="linkish" type="button" id="holdCancel">Cancel my hold</button>
              </div>
              {status === 'active' && (
                <div id="holdStart">
                  <button class="btn btn-primary" type="button" id="holdBtn">Hold this card</button>
                  <p class="muted small">The dealer sets it aside for you for 24 hours. You pay the dealer when you meet, at their table or however you arrange. Nothing is charged on CardShow.</p>
                </div>
              )}
              <form id="holdForm" class="hold-form" hidden>
                <label class="field">Your name<input name="name" maxlength="60" autocomplete="name" required /></label>
                <label class="field">How the dealer can reach you<input name="contact" maxlength="120" placeholder="Phone, email or Instagram" required /></label>
                <label class="field">Note for the dealer (optional)<textarea name="note" maxlength="300" rows="2" placeholder="When you can meet, questions…"></textarea></label>
                <div class="hold-actions">
                  <button class="btn btn-primary" type="submit" id="holdSubmit">Hold for 24 hours</button>
                  <button class="btn" type="button" id="holdBack">Cancel</button>
                </div>
              </form>
              <p class="notice small" id="holdMsg" role="status" hidden></p>
              {status === 'active' && l.accepts_offers !== false && (
                <div class="offer" id="offerBox" data-price={l.price_cents}>
                  <div id="offerStart">
                    <button class="btn" type="button" id="offerBtn">Make an offer</button>
                  </div>
                  <div id="offerMine" class="offer-mine" hidden>
                    <b id="offerHead"></b>
                    <span id="offerSub" class="muted small"></span>
                    <div id="offerAnswer" class="hold-actions" hidden>
                      <button class="btn btn-primary" type="button" id="offerAccept">Accept</button>
                      <button class="btn" type="button" id="offerCounterBtn">Counter</button>
                      <button class="btn" type="button" id="offerDecline">Decline</button>
                    </div>
                    <form id="offerCounterForm" class="hold-form" hidden>
                      <label class="field">Your counter ($)<input name="amount" inputmode="decimal" autocomplete="off" required /></label>
                      <div class="hold-actions">
                        <button class="btn btn-primary" type="submit" id="offerCounterSend">Send counter</button>
                        <button class="btn" type="button" id="offerCounterBack">Cancel</button>
                      </div>
                    </form>
                    <button class="linkish" type="button" id="offerWithdraw" hidden>Withdraw my offer</button>
                  </div>
                  <form id="offerForm" class="hold-form" hidden>
                    <label class="field">Your offer ($)<input name="amount" inputmode="decimal" autocomplete="off" placeholder={`Asking ${money(l.price_cents)}`} required /></label>
                    <label class="field">Your name<input name="name" maxlength="60" autocomplete="name" required /></label>
                    <label class="field">How the dealer can reach you<input name="contact" maxlength="120" placeholder="Phone, email or Instagram" required /></label>
                    <label class="field">Note for the dealer (optional)<textarea name="note" maxlength="300" rows="2" placeholder="When you can meet, questions…"></textarea></label>
                    <div class="hold-actions">
                      <button class="btn btn-primary" type="submit" id="offerSubmit">Send offer</button>
                      <button class="btn" type="button" id="offerBack">Cancel</button>
                    </div>
                    <p class="muted small">The dealer has 24 hours to accept, decline or counter. If they accept, the card is held for you for 24 hours at that price and you pay them when you meet.</p>
                  </form>
                  <p class="notice small" id="offerMsg" role="status" hidden></p>
                </div>
              )}
            </div>
            <p class="muted small">Or reach the dealer directly{show ? ' or find them at the show' : ''}.</p>
            {show && (
              <div class="show">
                {show.pickup && <span class="muted small">Pickup show</span>}
                <b>{show.name}</b>
                <span>{[show.start_date ? dateRange(show.start_date, show.end_date) : '', show.venue, place(show)].filter(Boolean).join(' · ')}</span>
                {show.table_number && <span class="table">Table {show.table_number}</span>}
                <a href={showUrl}>More cards at this show →</a>
              </div>
            )}
            <div class="contact">
              {waUrl && <a class="btn btn-primary" href={waUrl} rel="nofollow noopener" target="_blank">Message on WhatsApp</a>}
              {igUrl && <a class="btn" href={igUrl} rel="nofollow noopener" target="_blank">Instagram @{dealer.instagram}</a>}
            </div>
            {!waUrl && !igUrl && !show && <p class="muted small">This dealer hasn’t added contact details yet. See their other cards below.</p>}
          </section>
        )}

        <dl class="details">
          {details.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
        </dl>

        <a class="dealer" href={dealer.url}>
          <span class="muted small">Sold by</span>
          <b>{dealer.display_name}</b>
          <span class="muted small">See all their cards →</span>
        </a>
      </div>
    </article>
  )}
</Base>

<style>
  .gone { text-align: center; padding: 48px 0; }
  .listing { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 28px; margin-top: 20px; }
  .media img { width: 100%; height: auto; max-height: 78vh; object-fit: contain; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border); }
  /* Catalog images are small: shown at their own size in a frame instead of stretched and blurry. */
  .media.is-catalog .frame { display: flex; align-items: center; justify-content: center; padding: 32px 16px;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); }
  .media.is-catalog .frame img { width: auto; height: auto; max-width: 100%; max-height: none; border: 0; border-radius: 4px; background: none; }
  .media .ph { aspect-ratio: 5 / 7; display: flex; align-items: center; justify-content: center; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); color: var(--muted); }
  .small { font-size: 13px; margin: 6px 0 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .delivery { list-style: none; padding: 0; margin: 10px 0 0; display: flex; flex-direction: column; gap: 4px; }
  .info h1 { margin-top: 10px; overflow-wrap: anywhere; }
  .price { font-size: 34px; font-weight: 700; }
  .box { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 16px; margin-top: 16px; }
  .box h2 { font-size: 16px; margin: 0; }
  .row { display: flex; justify-content: space-between; gap: 12px; padding: 2px 0; }
  .comp .row b { font-size: 20px; }
  .pct { font-weight: 600; }
  .pct.under { color: var(--good); }
  .pct.over { color: var(--warn); }
  .gtcr b { color: var(--good); }
  .show { display: flex; flex-direction: column; gap: 2px; margin-top: 12px; padding: 10px 12px; background: var(--surface); border-radius: 10px; }
  .show .table { font-family: var(--font-mono); color: var(--accent); }
  .show a { color: var(--accent); font-size: 14px; }
  .contact { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .details { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px 16px; margin: 18px 0 0; }
  .details dt { color: var(--muted); }
  .details dd { margin: 0; overflow-wrap: anywhere; }
  .dealer { display: flex; flex-direction: column; margin-top: 18px; padding: 12px 16px; border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none; }
  .dealer:hover { border-color: #33406a; }
  .hold { margin-top: 12px; display: flex; flex-direction: column; gap: 8px; }
  .hold [hidden] { display: none !important; }
  .hold-other { margin: 0; color: var(--warn); }
  .hold-mine { display: flex; flex-direction: column; gap: 4px; padding: 10px 12px; border: 1px solid var(--good); border-radius: 10px; }
  .hold-mine b { color: var(--good); }
  .hold-form { display: flex; flex-direction: column; gap: 10px; }
  .hold-form textarea { font: inherit; }
  .hold-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .linkish { background: none; border: 0; color: var(--muted); text-decoration: underline; cursor: pointer; padding: 0; align-self: flex-start; font: inherit; font-size: 14px; }
  #holdMsg, #offerMsg { margin: 0; }
  .offer { display: flex; flex-direction: column; gap: 8px; }
  .offer [hidden] { display: none !important; }
  .offer-mine { display: flex; flex-direction: column; gap: 6px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; }
  .offer-mine.is-turn { border-color: var(--accent); }
  #offerBtn { align-self: flex-start; }
  @media (max-width: 760px) {
    .hold-actions .btn, #holdBtn, #offerBtn { flex: 1 1 100%; width: 100%; }
    .listing { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .media img { max-height: 60vh; }
    .contact .btn { flex: 1 1 100%; }
  }
</style>

<script>
  import { sb, currentUser } from '../../lib/browser.js';

  // ── Holds: the dealer sets the card aside for 24 hours; the buyer pays them when they meet. ──
  const box = document.getElementById('holdBox') as HTMLElement | null;
  if (box) {
    const $ = (id: string) => document.getElementById(id) as any;
    const listingId = box.dataset.id!;
    let myHoldId = '';
    const say = (t: string) => { const m = $('holdMsg'); m.hidden = !t; m.textContent = t; };
    const until = (iso: string) => new Date(iso).toLocaleString([], { weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    const showMine = (id: string, expires: string, agreedCents?: number | null) => {
      myHoldId = id;
      $('holdMine').hidden = false; $('holdUntil').textContent = `Until ${until(expires)}.`;
      $('holdPrice').hidden = !agreedCents; if (agreedCents) $('holdPrice').textContent = `At your agreed price of ${dollars(agreedCents)}.`;
      if ($('offerBox')) $('offerBox').hidden = true;
      if ($('holdStart')) $('holdStart').hidden = true; $('holdForm').hidden = true;
      if ($('holdOther')) $('holdOther').hidden = true;
      document.querySelector('.chip-hold')?.remove();
    };
    const showStart = () => {
      myHoldId = ''; $('holdMine').hidden = true; $('holdForm').hidden = true;
      if ($('holdStart')) $('holdStart').hidden = false;
      if ($('offerBox')) $('offerBox').hidden = false;
    };
    const dollars = (c: number) => `$${(c / 100).toLocaleString('en-US', { minimumFractionDigits: c % 100 ? 2 : 0, maximumFractionDigits: 2 })}`;
    const notify = async (reservationId: string) => {
      try {
        const { data } = await sb().auth.getSession();
        const t = data?.session?.access_token; if (!t) return;
        fetch('/.netlify/functions/hold-notify-now', { method: 'POST', keepalive: true,
          headers: { Authorization: `Bearer ${t}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ reservation_id: reservationId }) }).catch(() => {});
      } catch {}
    };
    const ERR: Record<string, string> = {
      unavailable: 'Someone else just held or bought this card.',
      reservation_limit: 'You’re holding 10 cards already. Cancel one first (Account → Your holds).',
      hold_limit_day: 'You’ve placed a lot of holds today. Try again tomorrow.',
      own_listing: 'This is your own card.',
      early_access: 'This card isn’t open for holds yet.',
      not_found: 'This card isn’t listed any more.',
      missing_name: 'Add your name.',
      missing_contact: 'Add a phone number, email or Instagram so the dealer can reach you.',
    };
    const openForm = async () => {
      const user = await currentUser();
      if (!user) {
        location.href = `/account?next=${encodeURIComponent(box.dataset.url + '?hold=1')}`;
        return;
      }
      const f = $('holdForm') as HTMLFormElement;
      let saved: any = {}; try { saved = JSON.parse(localStorage.getItem('cardshowHoldContact') || '{}'); } catch {}
      (f.elements.namedItem('name') as HTMLInputElement).value ||= saved.name || '';
      (f.elements.namedItem('contact') as HTMLInputElement).value ||= saved.contact || user.email || '';
      if ($('holdStart')) $('holdStart').hidden = true;
      f.hidden = false; say('');
      (f.elements.namedItem((f.elements.namedItem('name') as HTMLInputElement).value ? 'contact' : 'name') as HTMLInputElement).focus();
    };
    $('holdBtn')?.addEventListener('click', openForm);
    $('holdBack').addEventListener('click', () => { showStart(); say(''); });
    $('holdForm').addEventListener('submit', async (e: Event) => {
      e.preventDefault();
      const f = e.target as HTMLFormElement;
      const name = (f.elements.namedItem('name') as HTMLInputElement).value.trim();
      const contact = (f.elements.namedItem('contact') as HTMLInputElement).value.trim();
      const note = (f.elements.namedItem('note') as HTMLTextAreaElement).value.trim();
      const btn = $('holdSubmit') as HTMLButtonElement; btn.disabled = true; say('');
      try {
        const { data, error } = await sb().rpc('place_hold', { p_listing_id: listingId, p_name: name, p_contact: contact, p_note: note || null });
        if (error) throw error;
        if (data?.ok || data?.error === 'already_yours') {
          try { localStorage.setItem('cardshowHoldContact', JSON.stringify({ name, contact })); } catch {}
          showMine(data.reservation_id, data.expires_at);
          say(data.ok ? 'Done. The dealer has been told and will contact you.' : '');
          if (data.ok) notify(data.reservation_id);
        } else {
          say(ERR[data?.error] || 'Couldn’t hold this card. Try again.');
          if (data?.error === 'unavailable') { if ($('holdStart')) $('holdStart').hidden = true; f.hidden = true; }
        }
      } catch { say('Couldn’t hold this card. Check your connection and try again.'); }
      finally { btn.disabled = false; }
    });
    $('holdCancel').addEventListener('click', async () => {
      if (!myHoldId || !confirm('Cancel your hold? The card goes back on sale.')) return;
      const id = myHoldId;
      const { data, error } = await sb().rpc('cancel_hold', { p_reservation_id: id });
      if (error || data?.error) { say('Couldn’t cancel. Try again.'); return; }
      showStart(); say('Hold cancelled. The card is back on sale.');
      if (!$('holdStart')) location.reload();
      notify(id);
    });
    (async () => {
      const user = await currentUser();
      if (!user) { if (new URLSearchParams(location.search).get('hold') === '1' && box.dataset.status === 'active') openForm(); return; }
      try {
        const { data } = await sb().rpc('my_holds');
        const mine = (Array.isArray(data) ? data : []).find((h: any) => h.status === 'active' && (h.cards || []).some((c: any) => c.id === listingId));
        if (mine) { showMine(mine.id, mine.expires_at, mine.agreed_cents); return; }
      } catch {}
      if (new URLSearchParams(location.search).get('hold') === '1' && box.dataset.status === 'active') openForm();
    })();

    // ── Offers: the dealer accepts, declines or counters; an accepted offer becomes a hold at that price. ──
    const ob = document.getElementById('offerBox') as HTMLElement | null;
    if (ob) {
      const price = Number(ob.dataset.price || 0);
      let offer: any = null;
      const osay = (t: string) => { const m = $('offerMsg'); m.hidden = !t; m.textContent = t; };
      const toCents = (v: string) => { const n = parseFloat(String(v).replace(/[$,\s]/g, '')); return Number.isFinite(n) ? Math.round(n * 100) : NaN; };
      const notifyOffer = async (offerId: string) => {
        try {
          const { data } = await sb().auth.getSession();
          const t = data?.session?.access_token; if (!t) return;
          fetch('/.netlify/functions/offer-notify-now', { method: 'POST', keepalive: true,
            headers: { Authorization: `Bearer ${t}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ offer_id: offerId }) }).catch(() => {});
        } catch {}
      };
      const OERR: Record<string, string> = {
        bad_amount: 'Enter an amount of at least $1.',
        above_price: 'That’s more than the asking price. Hold the card instead.',
        already_open: 'You already have an offer on this card.',
        offer_limit_day: 'You’ve made a lot of offers today. Try again tomorrow.',
        no_offers: 'This dealer isn’t taking offers on this card.',
        unavailable: 'Someone else just held or bought this card.',
        own_listing: 'This is your own card.',
        early_access: 'This card isn’t open for offers yet.',
        not_found: 'This card isn’t listed any more.',
        missing_name: 'Add your name.',
        missing_contact: 'Add a phone number, email or Instagram so the dealer can reach you.',
        bad_counter: 'Your counter has to be more than your last offer and less than the dealer’s.',
        no_more_counters: 'You can only accept or decline now.',
        expired: 'This offer ran out. You can make a new one.',
        not_your_turn: 'The dealer is still deciding.',
      };
      const showOfferStart = () => {
        offer = null; $('offerStart').hidden = false; $('offerMine').hidden = true; $('offerForm').hidden = true;
      };
      const showOffer = (o: any) => {
        offer = o;
        $('offerForm').hidden = true; $('offerCounterForm').hidden = true;
        const open = o.status === 'pending' || o.status === 'countered';
        $('offerStart').hidden = open;
        $('offerMine').hidden = false;
        $('offerMine').classList.toggle('is-turn', o.status === 'countered');
        $('offerAnswer').hidden = o.status !== 'countered';
        $('offerWithdraw').hidden = !open;
        $('offerCounterBtn').hidden = !o.can_counter;
        const by = o.expires_at ? `Answer by ${until(o.expires_at)}.` : '';
        if (o.status === 'pending') {
          $('offerHead').textContent = `Your offer: ${dollars(o.amount_cents)}`;
          $('offerSub').textContent = `Waiting for the dealer. They have until ${until(o.expires_at)} to answer.`;
        } else if (o.status === 'countered') {
          $('offerHead').textContent = `The dealer countered at ${dollars(o.amount_cents)}`;
          const mine = (o.history || []).filter((h: any) => h.by === 'buyer').pop();
          $('offerSub').textContent = `${mine ? `You offered ${dollars(mine.cents)}. ` : ''}${by}`;
          $('offerAccept').textContent = `Accept ${dollars(o.amount_cents)}`;
        } else if (o.status === 'declined') {
          $('offerHead').textContent = `Your offer of ${dollars(o.amount_cents)} was declined`;
          $('offerSub').textContent = o.decided_by === 'auto' ? 'The dealer doesn’t take offers that low on this card.' : 'You can make another offer.';
        } else if (o.status === 'expired') {
          $('offerHead').textContent = `Your offer of ${dollars(o.amount_cents)} ran out`;
          $('offerSub').textContent = 'You can make another offer.';
        } else { showOfferStart(); }
      };
      const openOfferForm = async () => {
        const user = await currentUser();
        if (!user) { location.href = `/account?next=${encodeURIComponent(box.dataset.url + '?offer=1')}`; return; }
        const f = $('offerForm') as HTMLFormElement;
        let saved: any = {}; try { saved = JSON.parse(localStorage.getItem('cardshowHoldContact') || '{}'); } catch {}
        (f.elements.namedItem('name') as HTMLInputElement).value ||= saved.name || '';
        (f.elements.namedItem('contact') as HTMLInputElement).value ||= saved.contact || user.email || '';
        $('offerStart').hidden = true; f.hidden = false; osay('');
        (f.elements.namedItem('amount') as HTMLInputElement).focus();
      };
      $('offerBtn').addEventListener('click', openOfferForm);
      $('offerBack').addEventListener('click', () => { $('offerForm').hidden = true; $('offerStart').hidden = false; osay(''); });
      $('offerForm').addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const f = e.target as HTMLFormElement;
        const cents = toCents((f.elements.namedItem('amount') as HTMLInputElement).value);
        const name = (f.elements.namedItem('name') as HTMLInputElement).value.trim();
        const contact = (f.elements.namedItem('contact') as HTMLInputElement).value.trim();
        const note = (f.elements.namedItem('note') as HTMLTextAreaElement).value.trim();
        if (!(cents >= 100)) { osay(OERR.bad_amount); return; }
        if (price && cents > price) { osay(OERR.above_price); return; }
        const btn = $('offerSubmit') as HTMLButtonElement; btn.disabled = true; osay('');
        try {
          const { data, error } = await sb().rpc('make_offer', { p_listing_id: listingId, p_amount_cents: cents, p_name: name, p_contact: contact, p_note: note || null });
          if (error) throw error;
          if (data?.ok) {
            try { localStorage.setItem('cardshowHoldContact', JSON.stringify({ name, contact })); } catch {}
            f.hidden = true;
            if (data.status === 'accepted') {
              showMine(data.reservation_id, data.hold_expires_at, data.agreed_cents);
              say(`Accepted! The card is on hold for you at ${dollars(data.agreed_cents)}. The dealer has been told and will contact you.`);
              notifyOffer(data.offer_id);
            } else if (data.status === 'declined') {
              showOffer({ status: 'declined', amount_cents: cents, decided_by: 'auto' });
            } else {
              showOffer({ id: data.offer_id, status: 'pending', amount_cents: cents, expires_at: data.expires_at, history: [{ by: 'buyer', cents }] });
              osay('Offer sent. The dealer has been told.');
              notifyOffer(data.offer_id);
            }
          } else {
            osay(OERR[data?.error] || 'Couldn’t send your offer. Try again.');
            if (data?.error === 'already_open') { f.hidden = true; loadOffer(); }
          }
        } catch { osay('Couldn’t send your offer. Check your connection and try again.'); }
        finally { btn.disabled = false; }
      });
      const answer = async (action: string, cents?: number) => {
        if (!offer?.id) return;
        const { data, error } = await sb().rpc('buyer_respond_offer', { p_offer_id: offer.id, p_action: action, p_counter_cents: cents ?? null });
        if (error) { osay('Couldn’t send that. Check your connection and try again.'); return; }
        if (data?.error) { osay(OERR[data.error] || 'Couldn’t send that. Try again.'); if (data.error === 'expired') loadOffer(); return; }
        notifyOffer(offer.id);
        if (action === 'accept' && data.status === 'accepted') {
          showMine(data.reservation_id, data.hold_expires_at, data.agreed_cents);
          osay(''); say(`Done. The card is on hold for you at ${dollars(data.agreed_cents)}. The dealer has been told.`);
        } else if (action === 'decline') { showOffer({ ...offer, status: 'declined', decided_by: 'buyer' }); osay('Counter declined. The card stays on sale.'); }
        else { await loadOffer(); osay('Counter sent. The dealer has been told.'); }
      };
      $('offerAccept').addEventListener('click', () => { if (offer && confirm(`Accept ${dollars(offer.amount_cents)}? The card is held for you for 24 hours and you pay the dealer when you meet.`)) answer('accept'); });
      $('offerDecline').addEventListener('click', () => { if (confirm('Decline the dealer’s counter?')) answer('decline'); });
      $('offerCounterBtn').addEventListener('click', () => { $('offerAnswer').hidden = true; $('offerCounterForm').hidden = false; osay('');
        ($('offerCounterForm').elements.namedItem('amount') as HTMLInputElement).focus(); });
      $('offerCounterBack').addEventListener('click', () => { $('offerCounterForm').hidden = true; $('offerAnswer').hidden = false; });
      $('offerCounterForm').addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const cents = toCents(($('offerCounterForm').elements.namedItem('amount') as HTMLInputElement).value);
        if (!(cents >= 100)) { osay(OERR.bad_amount); return; }
        const btn = $('offerCounterSend') as HTMLButtonElement; btn.disabled = true;
        try { await answer('counter', cents); } finally { btn.disabled = false; }
      });
      $('offerWithdraw').addEventListener('click', async () => {
        if (!offer?.id || !confirm('Withdraw your offer?')) return;
        const { data, error } = await sb().rpc('withdraw_offer', { p_offer_id: offer.id });
        if (error || data?.error) { osay('Couldn’t withdraw. Try again.'); return; }
        showOfferStart(); osay('Offer withdrawn.');
      });
      const loadOffer = async () => {
        const user = await currentUser();
        if (!user) { if (new URLSearchParams(location.search).get('offer') === '1') openOfferForm(); return; }
        try {
          const { data } = await sb().rpc('my_offers');
          const mine = (Array.isArray(data) ? data : []).filter((o: any) => o.listing_id === listingId)
            .sort((a: any, b: any) => String(b.updated_at).localeCompare(String(a.updated_at)))[0];
          if (mine && ['pending', 'countered', 'declined', 'expired'].includes(mine.status)) { showOffer(mine); return; }
        } catch {}
        if (new URLSearchParams(location.search).get('offer') === '1') openOfferForm();
      };
      loadOffer();
    }
  }

  // Ask for a fresh market value when someone looks at an active card (never waits; the pricing job
  // picks it up within minutes, and request_card_value_refresh() skips values that are current).
  const el = document.querySelector('.listing') as HTMLElement | null;
  const d = document.documentElement.dataset;
  if (el && el.dataset.status === 'active' && d.sbUrl && d.sbKey) {
    fetch(`${d.sbUrl}/rest/v1/rpc/request_card_value_refresh`, {
      method: 'POST', keepalive: true,
      headers: { apikey: d.sbKey, Authorization: `Bearer ${d.sbKey}`, 'Content-Type': 'application/json' },
      body: JSON.stringify({ p_listing_id: el.dataset.id }),
    }).catch(() => {});
  }
</script>
