---
// /d/<handle> — a dealer's storefront: every card they have listed.
import Base from '../../layouts/Base.astro';
import ListingTile from '../../components/ListingTile.astro';
import { rpc } from '../../lib/api.js';
import { PAGE_SIZE, SORTS, CATEGORIES, fromQuery } from '../../lib/search.js';

const handle = String(Astro.params.handle || '').slice(0, 40);
// Filters from the URL (same names as /search): q, category, graded, min, max, sort, page. The dealer is fixed.
const { p, form, page } = fromQuery(Astro.url.searchParams);
const sort = p.sort && p.sort !== 'distance' ? p.sort : 'newest';
const params: any = { dealer: handle, sort, limit: PAGE_SIZE, offset: (page - 1) * PAGE_SIZE };
for (const k of ['q', 'category', 'raw', 'price_min_cents', 'price_max_cents', 'deals_only']) if (p[k] !== undefined) params[k] = p[k];
const filtered = ['q', 'category', 'raw', 'price_min_cents', 'price_max_cents', 'deals_only'].some(k => params[k] !== undefined);
let store: any = null, result: any = { total: 0, results: [] }, failed = false;
if (/^[\w.-]{1,40}$/.test(handle)) {
  try {
    [store, result] = await Promise.all([
      rpc('get_dealer_storefront', { p_handle: handle }),
      rpc('search_listings', { p: params }),
    ]);
  } catch (e: any) { failed = true; console.error('[storefront]', e?.message); }
}
const found = store && !store.error;
if (failed) { Astro.locals.cache = 0; Astro.response.status = 503; }
else if (!found) { Astro.response.status = 404; Astro.locals.cache = 30; }
else if (store.handle !== handle) return Astro.redirect(`/d/${store.handle}${Astro.url.search}`, 301);
const pages = Math.max(1, Math.ceil((result.total || 0) / PAGE_SIZE));
const qs = (extra: Record<string, string | number> = {}) => {
  const sp = new URLSearchParams();
  if (form.q) sp.set('q', form.q);
  if (form.category) sp.set('category', form.category);
  if (form.graded) sp.set('graded', form.graded);
  if (form.min) sp.set('min', form.min);
  if (form.max) sp.set('max', form.max);
  if (form.deals) sp.set('deals', '1');
  if (sort !== 'newest') sp.set('sort', sort);
  for (const [k, v] of Object.entries(extra)) sp.set(k, String(v));
  const s = sp.toString();
  return `/d/${handle}${s ? '?' + s : ''}`;
};
const href = (n: number) => qs({ page: n });
---
<Base title={found ? `${store.display_name}'s cards` : 'Dealer not found'} canonical={found ? store.url : undefined}
      description={found ? `${store.listings} cards for sale from ${store.display_name} on CardShow.` : undefined} noindex={!found || page > 1 || filtered}>
  {!found && (
    <div class="gone">
      <h1>{failed ? 'Couldn’t load this dealer' : 'Dealer not found'}</h1>
      <a class="btn btn-primary" href="/search">Search cards</a>
    </div>
  )}
  {found && (
    <>
      <div class="store-head">
        <div>
          <h1>{store.display_name}</h1>
          <p class="muted">@{store.handle} · {store.listings} {store.listings === 1 ? 'card' : 'cards'} listed
            {store.instagram && <> · <a href={`https://instagram.com/${encodeURIComponent(store.instagram.replace(/^@/, ''))}`} rel="nofollow noopener" target="_blank">Instagram</a></>}</p>
        </div>
      </div>
      <form method="get" class="store-filters" id="storeFilters" action={`/d/${handle}`}>
        <label class="field grow">Search their cards<input name="q" value={form.q || ''} placeholder="Player, set, card…" /></label>
        <label class="field">Category
          <select name="category"><option value="">Any</option>{CATEGORIES.map(c => <option selected={form.category === c}>{c}</option>)}</select>
        </label>
        <label class="field">Graded or raw
          <select name="graded">
            <option value="">Either</option>
            <option value="graded" selected={form.graded === 'graded'}>Graded</option>
            <option value="raw" selected={form.graded === 'raw'}>Raw</option>
          </select>
        </label>
        <label class="field money">Min $<input name="min" inputmode="decimal" value={form.min || ''} /></label>
        <label class="field money">Max $<input name="max" inputmode="decimal" value={form.max || ''} /></label>
        <label class="field">Sort
          <select name="sort">
            {Object.entries(SORTS).filter(([k]) => k !== 'best' && k !== 'distance').map(([k, v]) => <option value={k} selected={sort === k}>{v}</option>)}
          </select>
        </label>
        <label class="check"><input type="checkbox" name="deals" value="1" checked={!!form.deals} /> Deals only</label>
        <button class="btn btn-primary" type="submit">Show</button>
      </form>
      {filtered && <p class="muted results-line" id="storeResults">{(result.total || 0).toLocaleString('en-US')} {result.total === 1 ? 'card' : 'cards'} match · <a href={`/d/${handle}`}>clear</a></p>}
      {result.total === 0 && <div class="notice">{filtered ? 'No cards match. Try fewer filters.' : 'No cards listed right now.'}</div>}
      <div class="grid">{result.results.map((l: any) => <ListingTile l={l} />)}</div>
      {pages > 1 && (
        <nav class="pager" aria-label="Pages">
          {page > 1 ? <a class="btn" href={href(page - 1)} rel="prev">← Previous</a> : <span />}
          <span class="muted">Page {page} of {pages}</span>
          {page < pages ? <a class="btn" href={href(page + 1)} rel="next">Next →</a> : <span />}
        </nav>
      )}
    </>
  )}
</Base>
<style>
  .gone { text-align: center; padding: 48px 0; }
  .store-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .store-head h1 { overflow-wrap: anywhere; }
  .store-head p { margin: 0; }
  .store-head a { color: var(--accent); }
  .store-filters { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; margin: 0 0 12px; }
  .store-filters .field { min-width: 130px; }
  .store-filters .money { min-width: 0; width: 100px; }
  .store-filters .grow { flex: 1 1 220px; }
  .store-filters .check { min-height: 42px; display: flex; align-items: center; gap: 6px; }
  .results-line { margin: 0 0 12px; }
  .results-line a { color: var(--accent); }
  @media (max-width: 640px) {
    .store-filters .field { flex: 1 1 calc(50% - 10px); min-width: 0; width: auto; }
    .store-filters .grow { flex-basis: 100%; }
    .store-filters .btn { flex: 1 1 100%; }
  }
</style>
<script>
  // Empty fields stay out of the URL.
  const f = document.getElementById('storeFilters') as HTMLFormElement | null;
  f?.addEventListener('submit', () => {
    for (const el of Array.from(f.elements) as HTMLInputElement[]) {
      if (el.name && !String(el.value).trim()) el.disabled = true;
      if (el.name === 'sort' && el.value === 'newest') el.disabled = true;
    }
  });
</script>
